# Copy to .env and adjust. .env is gitignored.

# Which optional stacks start with a plain `docker compose up -d`
COMPOSE_PROFILES=airflow,observability,agent
COMPOSE_PROJECT_NAME=spark-homelab

# ---- Spark ----
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g

# ---- Jupyter ----
JUPYTER_TOKEN=homelab

# ---- Airflow ----
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
# Send Airflow metrics to the OTel collector (set False if the observability profile is off)
AIRFLOW_OTEL_ON=True

# ---- External SQL Server (runs outside Docker) ----
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_DB=master
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
# Note: avoid double quotes / backslashes in the password (it is embedded in a JSON connection string)

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- SFTP (landing zone -> data/sftp/upload) ----
# Password must not contain ':' (it is part of the container command)
SFTP_USERNAME=homelab
SFTP_PASSWORD=change-me
SFTP_PORT=22
# Server key fingerprint; the migration script refuses to connect if it changes.
# Show it with: docker compose exec sftp ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
SFTP_HOST_KEY_FINGERPRINT=

# ---- Azure File Share (landing layer: SFTP -> Azure) ----
# Storage account -> Security + networking -> Access keys -> Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_FILE_SHARE_NAME=landing
AZURE_LANDING_ROOT=Grid_Report

# ---- Slack alerts (Airflow DAG failures) ----
# Bot token (xoxb-...) needs the chat:write scope; invite the bot to the channel: /invite @your-bot
# (the signing secret isn't needed: it's only for receiving events from Slack)
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=#homelab-alerts

# ---- AI agent: GridIQ (agent/) ----
# Azure OpenAI via Microsoft Foundry: resource endpoint, key, API version and deployment names
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# The single gpt-4o deployment used for screening, SQL and answers
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# Leave empty for reasoning models that don't accept temperature
AZURE_OPENAI_TEMPERATURE=0
# Read-only SQL login for the agent (create it with agent/sql/create_readonly_login.sql)
AGENT_MSSQL_USER=grid_agent_reader
AGENT_MSSQL_PASSWORD=
# Optional limits
AGENT_MAX_ROWS=200
AGENT_QUERY_TIMEOUT_S=30
AGENT_MAX_TOOL_CALLS=6
# Langfuse tracing (optional until Langfuse is running)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001

# ---- Langfuse server (self-hosted, profile `agent`; generated, keep private) ----
# Login: http://localhost:3001 with LANGFUSE_INIT_USER_EMAIL / LANGFUSE_INIT_USER_PASSWORD
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=

# ---- ngrok (public HTTPS URL for Slack -> agent-api; profile `agent`) ----
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-static-domain.ngrok-free.dev
