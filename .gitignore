.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Terraform plan files (binary; contain subscription and resource details)
tfplan
*.tfplan

# Private documentation and personal notes (kept locally, not published)
docs/
note.txt

# Misc
*.log
