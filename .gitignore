airflow/logs/
airflow/config/airflow.cfg

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# SFTP uploads
data/sftp/

